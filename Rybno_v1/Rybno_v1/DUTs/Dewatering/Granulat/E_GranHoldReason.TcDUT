  <DUT Name="E_GranHoldReason" Id="{a9aa2ab8-385f-43ff-afbd-50f61a19be72}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
(*
===============================================================================
  ENUM: Powody HOLD (pauza procesu – wznowienie ręczne)
===============================================================================
*)
TYPE E_GranHoldReason :
(
    NONE            := 0,   // brak pauzy
    OPERATOR_PAUSE  := 1,   // pauza ręczna (SCADA)
    PERLITE_NO_GAIN := 20,  // brak przyrostu masy – perlit
    LIME_NO_GAIN    := 21   // brak przyrostu masy – wapno
);
END_TYPE
]]></Declaration>
  </DUT>
