<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_FlapControl" Id="{07295ea4-5bc8-4b87-82f1-717ede49bf54}">
    <Declaration><![CDATA[TYPE ST_FlapControl :
STRUCT
    // ============================
    // KOMENDY Z SCADA → DO FB
    // ============================

    bAuto           : BOOL;    // TRUE = AUTO, FALSE = MANUAL

    bCmdOpen        : BOOL;    // przycisk OTWÓRZ klapę
    bCmdClose       : BOOL;    // przycisk ZAMKNIJ klapę
    bCmdHome        : BOOL;    // przycisk BAZUJ (opcjonalnie użyjemy w homingu)
    bResetFault     : BOOL;    // przycisk RESET AWARII

    uiPosSP_Percent : UINT;    // zadana pozycja w AUTO (0..100%)

    // ============================
    // STATUS Z FB → DO SCADA
    // ============================

    rPosPV_Percent  : REAL;        // aktualne otwarcie klapy [%]
    nPosRaw         : DINT;        // surowy licznik z enkodera (nEnc)

    bIsOpen         : BOOL;        // klapa otwarta
    bIsClosed       : BOOL;        // klapa zamknięta
    bIsMoving       : BOOL;        // klapa w ruchu
    bFault          : BOOL;        // awaria klapy

    eState          : E_FlapState; // aktualny stan maszyny
    sStatusText     : T_MaxString;  // "Zamknięta", "Otwieranie", "Otwarta", "Zamykanie", "Awaria"
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>