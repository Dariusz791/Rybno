<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <GVL Name="GVL_Fermentation" Id="{cc117358-723a-400c-85ce-155561b7a837}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
	


	
(**************************************************** R01 MX01 i MX02 *****************************************************************)
	//**********************************MX01 **************************
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	{attribute 'OPC.UA.DA.Description' := 'stDriveStatus_MX01 (structured) type '} 
	stDriveStatus_MX01 : ST_DriveStatus;
	
	//**********************************MX02 **************************
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	{attribute 'OPC.UA.DA.Description' := 'stDriveStatus_MX02 (structured) type '} 
	stDriveStatus_MX02 : ST_DriveStatus;
	
	//**********************************Mix Station MX01 iMX02 **************************
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	{attribute 'OPC.UA.DA.Description' := 'stMixStation (structured) type '} 
	stMixStation : ST_MixStation;
	
	


(**************************************************** R-01 *****************************************************************)	
	//**************************** Temperature Sensor  01 ***************************************************************
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.AnalogItemType' := '1'}
	{attribute 'OPC.UA.DA.AnalogItemType.EngineeringUnits' := '4408652'  }(*EngeneeringUnit = degree Celsius*)
	{attribute 'OPC.UA.DA.AnalogItemType.InstrumentRange' := '0:100'  }
	{attribute 'OPC.UA.DA.AnalogItemType.EURange' := '40:55'  }
	{attribute 'OPC.UA.DA.AnalogItemType.WriteBehavior' := '2'  } (*AnalogWrMode_AllowAny = 0,
																	AnalogWrMode_Clamp = 1,
																	AnalogWrMode_Reject = 2,*)  
	TempSens_R01 : ST_AnalogSens;

	
	//**************************** Level Sensor 01 ***************************************************************
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.AnalogItemType' := '1'}
	{attribute 'OPC.UA.DA.AnalogItemType.EngineeringUnits' := '4935745'  }(*EngeneeringUnit = kPa*)
	{attribute 'OPC.UA.DA.AnalogItemType.InstrumentRange' := '0:10'  } (*0- 2m*)
	{attribute 'OPC.UA.DA.AnalogItemType.EURange' := '2:3'  }			(*pracujemy w zakresie od 3 do 6 kPa*)
	{attribute 'OPC.UA.DA.AnalogItemType.WriteBehavior' := '2'  } (*AnalogWrMode_AllowAny = 0,
																	AnalogWrMode_Clamp = 1,
																	AnalogWrMode_Reject = 2,*)
	LevelSens_R01 : ST_AnalogSens;
	

	//**************************** Pressure Sensor 01 ***************************************************************
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.AnalogItemType' := '1'}
	{attribute 'OPC.UA.DA.AnalogItemType.EngineeringUnits' := '4935745'  }(*EngeneeringUnit = kPa*)
	{attribute 'OPC.UA.DA.AnalogItemType.InstrumentRange' := '0:10'  } (*0- 10kPa*)
	{attribute 'OPC.UA.DA.AnalogItemType.EURange' := '3:6'  }			(*pracujemy w zakresie od 3 do 6 kPa*)
	{attribute 'OPC.UA.DA.AnalogItemType.WriteBehavior' := '2'  } (*AnalogWrMode_AllowAny = 0,
																	AnalogWrMode_Clamp = 1,
																	AnalogWrMode_Reject = 2,*)
	PressureSens_R01 : ST_AnalogSens;
	
	//**************************** Pressure Sensor 01 ***************************************************************
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.AnalogItemType' := '1'}
	{attribute 'OPC.UA.DA.AnalogItemType.EngineeringUnits' := '4935745'  }(*EngeneeringUnit = kPa*)
	{attribute 'OPC.UA.DA.AnalogItemType.InstrumentRange' := '0:10'  } (*0- 10kPa*)
	{attribute 'OPC.UA.DA.AnalogItemType.EURange' := '3:6'  }			(*pracujemy w zakresie od 3 do 6 kPa*)
	{attribute 'OPC.UA.DA.AnalogItemType.WriteBehavior' := '2'  } (*AnalogWrMode_AllowAny = 0,
																	AnalogWrMode_Clamp = 1,
																	AnalogWrMode_Reject = 2,*)
	HydroPressSens_R01 : ST_AnalogSens;
	
	//**************************** pH Sensor 01 ***************************************************************
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.AnalogItemType' := '1'}
	{attribute 'OPC.UA.DA.AnalogItemType.EngineeringUnits' := '104575'}  (* EngineeringUnit = pH *)
	{attribute 'OPC.UA.DA.AnalogItemType.InstrumentRange' := '0:14'  } (*0- 14*)
	{attribute 'OPC.UA.DA.AnalogItemType.EURange' := '3:6'  }			(*pracujemy w zakresie od 7 do 8,5 kPa*)
	{attribute 'OPC.UA.DA.AnalogItemType.WriteBehavior' := '2'  } (*AnalogWrMode_AllowAny = 0,
																	AnalogWrMode_Clamp = 1,
																	AnalogWrMode_Reject = 2,*)
	PhSens_R01 : ST_AnalogSens;
	
	
	
	
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>