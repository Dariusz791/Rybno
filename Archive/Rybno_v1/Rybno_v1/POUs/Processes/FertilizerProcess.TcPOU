<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FertilizerProcess" Id="{ae9cea5e-de76-4d67-bab9-1dcc1d16bc80}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM FertilizerProcess
VAR
	//Napedy M01 M02 VR01 - schemat U71, U81	
	fbDrvInv_M01 		: FB_DriveInv(7, E_InvType.Schneider);
	fbDrvContrInv_M01   : FB_DriveControl(fbDrvInv_M01);
	
	fbDrvInv_M02 		: FB_DriveInv(8, E_InvType.Schneider);
	fbDrvContrInv_M02   : FB_DriveControl(fbDrvInv_M02);
	
	//Naped klapy M03 VR01 - schemat U91 
	fbDrvInv_M03 		: FB_DriveInv(9, E_InvType.Schneider);
	fbDrvContrInv_M03   : FB_DriveControl(fbDrvInv_M03);
	
	//Naped wentylator BL01
	fbDrv_BL01			: FB_Drive_1C();
	fbDrvContr_BL01		: FB_DriveControl(fbDrv_BL01);

	//Napedy podajnik SC-01 i SC02
	fbDrv_SC01			: FB_Drive_1C();
	fbDrvContr_SC01	    : FB_DriveControl(fbDrv_SC01);
	
	fbDrv_SC02			: FB_Drive_1C();
	fbDrvContr_SC02		: FB_DriveControl(fbDrv_SC02);
		
	//Napedy S01_E01 i S02_E02
	fbDrv_E01			: FB_Drive_1C();
	fbDrvContr_E01	    : FB_DriveControl(fbDrv_E01);
	
	fbDrv_E02			: FB_Drive_1C();
	fbDrvContr_E02		: FB_DriveControl(fbDrv_E02);
	
	//Temp Sensor
	fbTempSens_H01	 	: FB_Scaling; //Czujnik temperatury w reaktorze R01

	(***********************************************Process Controlller****************************************************************************************)

	(************** Flap controller **************************************************)
	//fbFlapControl		 	: FB_FlapCtrl; //controller bloku sterowania klapa
	
    


	bCmdHome   : BOOL;   // z SCADA – start bazowania testowego
	

	

//    bDrvOpen   : BOOL;   // sterowanie falownikiem – otwieranie
//    bDrvClose  : BOOL;   // sterowanie falownikiem – zamykanie
//    bHomeDone  : BOOL;   // flaga: baza złapana

    
	rZ         : R_TRIG; // wykrywanie zbocza na Z
	
	//sterowanie otwarciem klapy
	fbTrigFwd : R_TRIG; //zamykanie
    fbTrigRev : R_TRIG; //otwieranie

    bFwdActive : BOOL;   // napęd pracuje w przód (otwieranie)
    bRevActive : BOOL;   // napęd pracuje w tył (zamykanie)


    // sterowanie stanami klapy
   	eFlapState : E_FlapState := E_FlapState.IdleClosed;

    // impulsów do pełnego otwarcia
    nTargetOpen : DINT := 266;  // 800/3 = ~266 impulsów
    TOL 		: DINT := 3;            // tolerancja pozycji
	
	rOpenFast  : REAL := 5.0;  // Hz – prędkość szybka
    rOpenSlow  : REAL := 3.0;   // Hz – prędkość wolna
    rCloseFast : REAL := 5.0;
    rCloseSlow : REAL := 3.0;
    nDecelImp  : DINT := 80;    // ile impulsów przed celem zwalniamy
	
	nEncHelp	: UINT;	
	
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//Action
ACT_TempSens();
ACT_Motor(); //nastawy z SCADA
ACT_WeightSensor(); //Sensor wagowy
//ACT_Control(); //Sterowanie procesem higienizacji

//**********************************VR01*****************************************************
//M01
//fbDrvContrInv_M01.FreqSetPoint:=10;
//fbDrvContrInv_M01.SetForward:=TRUE;
fbDrvContrInv_M01();
GVL_Fertilizer.stDriveStatus_M01 := fbDrvContrInv_M01.StatusStruct(); //zwróc strukturę
//M02
fbDrvContrInv_M02();
GVL_Fertilizer.stDriveStatus_M02 := fbDrvContrInv_M02.StatusStruct(); //zwróc strukturę
//M03
//fbDrvContrInv_M03();
//GVL_Fertilizer.stDriveStatus_M03 := fbDrvContrInv_M03.StatusStruct();

//**********************************BL01*****************************************************
//BL01
fbDrvContr_BL01();
GVL_Fertilizer.stDriveStatus_BL01 := fbDrvContr_BL01.StatusStruct(); //zwróc strukturę

//**********************************S01 i S02*****************************************************
//SC01
fbDrvContr_SC01();
GVL_Fertilizer.stDriveStatus_SC01 := fbDrvContr_SC01.StatusStruct(); //zwróc strukturę
//SC02
fbDrvContr_SC02();
GVL_Fertilizer.stDriveStatus_SC02 := fbDrvContr_SC02.StatusStruct(); //zwróc strukturę
//E01
fbDrvContr_E01();
GVL_Fertilizer.stDriveStatus_E01 := fbDrvContr_E01.StatusStruct(); //zwróc strukturę
//E02
fbDrvContr_E02();
GVL_Fertilizer.stDriveStatus_E02 := fbDrvContr_E02.StatusStruct(); //zwróc strukturę


nEncHelp := GVL_Fertilizer.nEnc;
// DETEKCJA PRZYCISKÓW SCADA (tylko zbocze)
// Forward  = ZAMYKANIE
// Reverse  = OTWIERANIE
fbTrigFwd(CLK := GVL_Fertilizer.stDriveStatus_M03.bForward);
fbTrigRev(CLK := GVL_Fertilizer.stDriveStatus_M03.bReverse);

//// Start ZAMYKANIA
IF fbTrigFwd.Q THEN
    eFlapState := E_FlapState.Closing;
END_IF;

// Start OTWIERANIA
IF fbTrigRev.Q THEN
    eFlapState := E_FlapState.Opening;
END_IF;

// --- TEST BAZOWANIA ---
// Założenie: klapa jest trochę otwarta, chcemy ją zamknąć aż złapie Z.
rZ(CLK := GVL_Fertilizer.bSenZ);  // detekcja zbocza narastającego Z

// -----------------------------
// 2) Maszyna stanów
// -----------------------------
CASE eFlapState OF

    // ---------------------------------------------
    // 0) Klapa zamknięta, stan spoczynku
    // ---------------------------------------------
    E_FlapState.IdleClosed:

        bFwdActive := FALSE;   // zamykanie OFF
        bRevActive := FALSE;   // otwieranie OFF

        // Jeśli z jakiegoś powodu NIE jesteśmy na Z → dociągamy klapę
        IF NOT GVL_Fertilizer.bSenZ THEN
            eFlapState := E_FlapState.Closing;
        END_IF;
		
		IF GVL_Fertilizer.bSenz AND GVL_Fertilizer.nEnc <> 0 THEN		// 🔥 reset licznika enkodera do 0					
            GVL_Fertilizer.SetCounterValue := 0;
			GVL_Fertilizer.SetCounter := TRUE;
		ELSE
			GVL_Fertilizer.SetCounter := FALSE;
		END_IF


    // ---------------------------------------------
    // 1) OTWIERANIE (Reverse = otwieranie)
    //    szybka faza + wolna faza przed celem
    // ---------------------------------------------
    E_FlapState.Opening:

        bFwdActive := FALSE;
        bRevActive := TRUE;    // REVERSE = otwieranie
		
		GVL_Fertilizer.SetCounter := FALSE;

        // tu możesz wstawić dwie prędkości na falownik,
        // np. przez rSpeedSet wewnątrz fbDrvContrInv_M03:
        
        IF GVL_Fertilizer.nEnc < (nTargetOpen - nDecelImp) THEN
            fbDrvContrInv_M03.FreqSetPoint := rOpenFast;   // szybciej
        ELSE
            fbDrvContrInv_M03.FreqSetPoint := rCloseFast;    // wolniej przy celu
        END_IF
        

        // osiągnięto pozycję otwarcia
        IF GVL_Fertilizer.nEnc >= (nTargetOpen - TOL) THEN

            bRevActive := FALSE;
            eFlapState := E_FlapState.Opened;

            // opcjonalnie "wyciskamy" przycisk OTWÓRZ w SCADA
            GVL_Fertilizer.stDriveStatus_M03.bReverse := FALSE;
        END_IF;


    // ---------------------------------------------
    // 2) Klapa OTWARTA – czekamy na ZAMKNIJ
    // ---------------------------------------------
    E_FlapState.Opened:

        bFwdActive := FALSE;
        bRevActive := FALSE;
        // nic nie robimy – czekamy na zbocze Forward (Closing)


    // ---------------------------------------------
    // 3) ZAMYKANIE (Forward = zamykanie)
    //    szybka faza + wolna faza przed Z
    // ---------------------------------------------
    E_FlapState.Closing:

        bFwdActive := TRUE;     // FORWARD = zamykanie
        bRevActive := FALSE;

        // dwie prędkości przy zamykaniu:
        // daleko od zera szybciej, blisko zera wolno
        
        IF GVL_Fertilizer.nEnc > nDecelImp THEN
            fbDrvContrInv_M03.FreqSetPoint :=rCloseFast;   // szybciej
        ELSE
            fbDrvContrInv_M03.FreqSetPoint := rCloseSlow;    // wolniej przy bazie
        END_IF
        

        // bazowanie na Z – łapiemy ZBROCZE, nie tylko stan
        IF rZ.Q THEN
            bFwdActive := FALSE;
            eFlapState := E_FlapState.IdleClosed;

            // "wyciskamy" przycisk ZAMKNIJ w SCADA
            GVL_Fertilizer.stDriveStatus_M03.bForward := FALSE;
        END_IF;

END_CASE;


// podpięcie do sterownika falownika M03
fbDrvContrInv_M03.SetForward := bFwdActive;  // FORWARD = zamykanie
fbDrvContrInv_M03.SetReverse := bRevActive;  // REVERSE = otwieranie


////M03
fbDrvContrInv_M03();
GVL_Fertilizer.stDriveStatus_M03 := fbDrvContrInv_M03.StatusStruct(); //zwróc strukturę



//nEncHelp := GVL_Fertilizer.nEnc;

//// Obsługa przycisku Forward
//IF fbTrigFwd.Q THEN
//    // Jeśli napęd nie pracuje w przód → włącz przód, wyłącz tył
//    IF NOT bFwdActive THEN
//        bFwdActive := TRUE;
//        bRevActive := FALSE;
//    ELSE
//        // jeśli już pracował w przód, kolejne naciśnięcie zrobi STOP
//        bFwdActive := FALSE;
//    END_IF;

////    // "Wyciskamy" przycisk w SCADA
////    GVL_Fertilizer.stDriveStatus_M03.bForward := FALSE;
//END_IF;

//// Obsługa przycisku Reverse
//IF fbTrigRev.Q THEN
//    // Jeśli napęd nie pracuje w tył → włącz tył, wyłącz przód
//    IF NOT bRevActive THEN
//        bRevActive := TRUE;
//        bFwdActive := FALSE;
//    ELSE
//        // jeśli już pracował w tył, kolejne naciśnięcie zrobi STOP
//        bRevActive := FALSE;
//    END_IF;

////    // "Wyciskamy" przycisk w SCADA
////    GVL_Fertilizer.stDriveStatus_M03.bReverse := FALSE;
//END_IF;

//fbDrvContrInv_M03.SetForward := bFwdActive;
//fbDrvContrInv_M03.SetReverse := bRevActive;


//// --- TEST BAZOWANIA ---
//// Założenie: klapa jest trochę otwarta, chcemy ją zamknąć aż złapie Z.

//rZ(CLK := GVL_Fertilizer.bSenZ);  // detekcja zbocza narastającego Z



//IF rZ.Q THEN
// fbDrvContrInv_M03.SetForward := FALSE;		
// fbDrvContrInv_M03.SetReverse := FALSE;	 
// GVL_Fertilizer.stDriveStatus_M01.bForward := FALSE;
// GVL_Fertilizer.stDriveStatus_M01.bReverse := FALSE;
// // 🔥 reset licznika enkodera do 0
// GVL_Fertilizer.SetCounter      := TRUE;   // impuls na 1 cykl
// GVL_Fertilizer.SetCounterValue := 0;           
//END_IF

//fbDrvContrInv_M03.FreqSetPoint := 3.0;

////M03
//fbDrvContrInv_M03();
//GVL_Fertilizer.stDriveStatus_M03 := fbDrvContrInv_M03.StatusStruct(); //zwróc strukturę
]]></ST>
    </Implementation>
