    <Action Name="ACT_Motor" Id="{157fa111-0c10-4c74-bf66-984a77c8c761}">
      <Implementation>
        <ST><![CDATA[
//***********Naped ustawienia VR01************************
//nastawy z SCADA M01
fbDrvContrInv_M01.SetForward	:=GVL_Fertilizer.stDriveStatus_M01.bForward;
fbDrvContrInv_M01.SetReverse	:=GVL_Fertilizer.stDriveStatus_M01.bReverse;
fbDrvContrInv_M01.FreqSetPoint	:=GVL_Fertilizer.stDriveStatus_M01.FrequencySet;

//nastawy z SCADA M02
fbDrvContrInv_M02.SetForward	:=GVL_Fertilizer.stDriveStatus_M02.bForward;
fbDrvContrInv_M02.SetReverse	:=GVL_Fertilizer.stDriveStatus_M02.bReverse;
fbDrvContrInv_M02.FreqSetPoint	:=GVL_Fertilizer.stDriveStatus_M02.FrequencySet;

//nastawy z SCADA M03
//fbDrvContrInv_M03.SetForward	:=GVL_Fertilizer.stDriveStatus_M03.bForward;
//fbDrvContrInv_M03.SetReverse	:=GVL_Fertilizer.stDriveStatus_M03.bReverse;
//fbDrvContrInv_M03.FreqSetPoint  :=GVL_Fertilizer.stDriveStatus_M03.FrequencySet;


//***********Naped ustawienia BL01 ************************
//nastawy z SCADA SC01
fbDrvContr_BL01.SetForward	:=GVL_Fertilizer.stDriveStatus_BL01.bForward;


//***********Naped ustawienia S01 i S02************************
//nastawy z SCADA SC01
fbDrvContr_SC01.SetForward	:=GVL_Fertilizer.stDriveStatus_SC01.bForward;
//nastawy z SCADA SC02
fbDrvContr_SC02.SetForward	:=GVL_Fertilizer.stDriveStatus_SC02.bForward;
//nastawy z SCADA E01
fbDrvContr_E01.SetForward	:=GVL_Fertilizer.stDriveStatus_E01.bForward;
//nastawy z SCADA E02
fbDrvContr_E02.SetForward	:=GVL_Fertilizer.stDriveStatus_E02.bForward;
]]></ST>
