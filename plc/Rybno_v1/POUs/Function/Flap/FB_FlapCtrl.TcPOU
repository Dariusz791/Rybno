<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_FlapCtrl" Id="{635223af-7d75-45d4-827e-1e513765a4e7}" SpecialFunc="None">
    <Declaration><![CDATA[(*
============================================================
FB_FlapCtrl  – sterowanie klapą / zasuwą z enkoderem (PV) i HOME (Z)
============================================================

CEL:
- MANUAL (operator/SCADA) ma działać "pancernie" – prosto i niezawodnie.
- AUTO ma działać jako POZYCJONER do SP w zakresie 0..100%.
- Dodatkowo: "ZAMKNIĘTE" jest zawsze definiowane przez HOME (Z) – nie uznajemy
  "blisko zera" za zamknięte. SP=0% w AUTO zawsze wymaga dojazdu do HOME (rZ.Q)
  i wybazowania licznika.

============================================================
TRYBY
============================================================

1) MANUAL (bAuto = FALSE)
- bCmdOpen  : otwieranie (do końca ~100% wg nTargetOpen - TOLImp)
- bCmdClose : zamykanie do HOME (Z) -> po rZ.Q zerujemy licznik
- bCmdHome  : to samo co zamykanie do HOME
- bResetFault: reset stanu Fault (gdy bMotorFault=FALSE)

2) AUTO (bAuto = TRUE)
- Operator nie steruje przyciskami (bCmdOpen/bCmdClose/bCmdHome ignorowane).
- Blok nadrzędny podaje uiPosSP_Percent (0..100):
   * SP=0%  -> zawsze Closing do HOME (rZ.Q) + zerowanie enkodera
   * SP>0%  -> pozycjonowanie PV->SP z tolerancją nTolImpPos (w impulsach)
- bInPos:
   * SP=0%  -> TRUE dopiero gdy HOME=TRUE i eStateInt=IdleClosed
   * SP>0%  -> TRUE gdy PV (nEncClamped) mieści się w [SP-Tol .. SP+Tol]

============================================================
SŁOWNIK
============================================================
PV  = Process Value  = aktualna pozycja (u nas nEncClamped / rPosPV_Percent)
SP  = Set Point      = zadanie pozycji (u nas uiPosSP_Percent / nSP_Imp)
CV  = Control Value  = sterowanie (bDrvOpen/bDrvClose/rFreqSetpoint)

============================================================
UWAGI
============================================================
- Stan E_FlapState.Opened jest użyty jako "HOLD / IN_POS" w AUTO, żeby nie ruszać enumów.
  Dlatego bIsOpen nie może korzystać z (eStateInt=Opened); liczymy go tylko po PV%.
- bIsClosed jest TYLKO po HOME (Z), zgodnie z Twoim wymaganiem.
============================================================
*)

(*
============================================================
FB_FlapCtrl  – spójna wersja (MANUAL + AUTO pozycjoner)
============================================================

Najważniejsze zasady:
- "ZAMKNIĘTE" = HOME (Z). Nie uznajemy "blisko 0%".
- AUTO: pozycjoner do SP 0..100%.
  * SP=0% => do HOME (Z) + zerowanie licznika
  * SP>0 => do SP w impulsach (z tolerancją)
- MANUAL: operator Open/Close/Home działa niezależnie i pewnie.
- STOP na HOME realizujemy na poziomie bHomeSensor (level), żeby uniknąć
  przypadku: HOME już TRUE -> rZ.Q nie wystąpi -> napęd "mieli".

Uwaga:
- Stan Opened w AUTO oznacza HOLD/IN_POS (żeby nie ruszać enumu).
  Dlatego bIsOpen liczymy tylko z PV% (blisko 100%), bez (state=Opened).
============================================================
*)

FUNCTION_BLOCK FB_FlapCtrl
VAR_INPUT
    bAuto           : BOOL;

    // MANUAL
    bCmdOpen        : BOOL;
    bCmdClose       : BOOL;
    bCmdHome        : BOOL;
    bResetFault     : BOOL;

    // AUTO
    uiPosSP_Percent : UINT;   // 0..100%

    // sprzęt
    nEnc            : DINT;
    nTargetOpen     : DINT;
    bHomeSensor     : BOOL;
    bMotorFault     : BOOL;
END_VAR

VAR_OUTPUT
    // Status
    rPosPV_Percent  : REAL;
    nPosRaw         : DINT;
    bIsOpen         : BOOL;
    bIsClosed       : BOOL;     // tylko HOME+IdleClosed
    bIsMoving       : BOOL;
    bFlapFault      : BOOL;
    bInPos          : BOOL;     // AUTO: PV w tolerancji SP / HOME dla SP=0

    // Napęd
    bDrvOpen        : BOOL;
    bDrvClose       : BOOL;
    rFreqSetpoint   : REAL;

    // Bazowanie licznika
    bSetCounter     : BOOL;
    uiSetCounterVal : UINT;

    // Diagnostyka
    eState          : E_FlapState;
    sStatusText     : T_MaxString;
END_VAR

VAR
    eStateInt       : E_FlapState := E_FlapState.IdleClosed;

    fbTrigOpen      : R_TRIG;
    fbTrigClose     : R_TRIG;
    rZ              : R_TRIG;

    // % i prędkości
    rTolPerc        : REAL := 2.0;

    rOpenFast       : REAL := 25.0;
    rOpenSlow       : REAL := 20.0;
    rCloseFast      : REAL := 15.0;
    rCloseSlow      : REAL := 3.0;

    // profile/tolerancje
    nDecelImp       : DINT := 100;
    TOLImp          : DINT := 3;      // manual dojazd do 100%

    // AUTO pozycjoner
    nSP_Imp         : DINT;
    nTolImpPos      : DINT := 10;     // tolerancja pozycjonera (imp)

    // PV clamp
    nEncClamped     : DINT;
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// 1) Triggery + domyślne wyjścia
// ============================================================
fbTrigOpen(CLK := bCmdOpen);
fbTrigClose(CLK := bCmdClose);
rZ(CLK := bHomeSensor);

// Domyślne (jeśli CASE nie ustawi – stoi)
bDrvOpen        := FALSE;
bDrvClose       := FALSE;
rFreqSetpoint   := 0.0;

bSetCounter     := FALSE;
uiSetCounterVal := 0;

bIsMoving       := FALSE;
bInPos          := FALSE;


// ============================================================
// 2) Awaria napędu -> Fault
// ============================================================
IF bMotorFault THEN
    bFlapFault := TRUE;
    eStateInt  := E_FlapState.Fault;
END_IF;


// ============================================================
// 3) PV: enkoder i %
// ============================================================
nPosRaw := nEnc;

nEncClamped := nEnc;
IF nEncClamped < 0 THEN
    nEncClamped := 0;
END_IF;

IF (nTargetOpen > 0) AND (nEncClamped > nTargetOpen) THEN
    nEncClamped := nTargetOpen;
END_IF;

IF nTargetOpen > 0 THEN
    rPosPV_Percent := DINT_TO_REAL(nEncClamped) * 100.0 / DINT_TO_REAL(nTargetOpen);
ELSE
    rPosPV_Percent := 0.0;
END_IF;


// ============================================================
// 4) AUTO: SP w impulsach (0..nTargetOpen)
// ============================================================
IF nTargetOpen > 0 THEN
    nSP_Imp := (nTargetOpen * uiPosSP_Percent) / 100;
ELSE
    nSP_Imp := 0;
END_IF;

IF nSP_Imp < 0 THEN nSP_Imp := 0; END_IF;
IF (nTargetOpen > 0) AND (nSP_Imp > nTargetOpen) THEN nSP_Imp := nTargetOpen; END_IF;


// ============================================================
// 5) Decyzja MANUAL / AUTO (ustalenie stanu docelowego)
// ============================================================
IF eStateInt <> E_FlapState.Fault THEN

    // ---------------- MANUAL ----------------
    IF NOT bAuto THEN
        // HOME z palca
        IF bCmdHome THEN
            eStateInt := E_FlapState.Closing;
        END_IF;

        // Open/Close na zboczu
        IF fbTrigOpen.Q THEN
            eStateInt := E_FlapState.Opening;
        END_IF;

        IF fbTrigClose.Q THEN
            eStateInt := E_FlapState.Closing;
        END_IF;

    // ---------------- AUTO ----------------
    ELSE
        // AUTO: nie zmieniaj w trakcie ruchu
        IF (eStateInt <> E_FlapState.Opening) AND (eStateInt <> E_FlapState.Closing) THEN

            // SP=0% => chcemy HOME.
            // Jeśli HOME już jest TRUE -> od razu IdleClosed (i stój).
            // Jeśli nie -> Closing.
            IF uiPosSP_Percent = 0 THEN
                IF bHomeSensor THEN
                    eStateInt := E_FlapState.IdleClosed;
                ELSE
                    eStateInt := E_FlapState.Closing;
                END_IF;

            ELSE
                // SP>0 => pozycjoner PV->SP
                IF nEncClamped < (nSP_Imp - nTolImpPos) THEN
                    eStateInt := E_FlapState.Opening;
                ELSIF nEncClamped > (nSP_Imp + nTolImpPos) THEN
                    eStateInt := E_FlapState.Closing;
                ELSE
                    eStateInt := E_FlapState.Opened; // HOLD/IN_POS
                END_IF;
            END_IF;

        END_IF;
    END_IF;

END_IF;


// ============================================================
// 6) Maszyna stanów – sterowanie napędem
// ============================================================
CASE eStateInt OF

    // ---------------- IdleClosed (HOME) ----------------
    E_FlapState.IdleClosed:
        bDrvOpen      := FALSE;
        bDrvClose     := FALSE;
        rFreqSetpoint := 0.0;
        bIsMoving     := FALSE;

        // Jeśli ktoś "wyrwał" HOME a jesteśmy w IdleClosed -> dobij do HOME
        IF NOT bHomeSensor THEN
            eStateInt := E_FlapState.Closing;
        END_IF;

        // Porządkowanie licznika na HOME
        IF bHomeSensor AND (nEnc <> 0) THEN
            uiSetCounterVal := 0;
            bSetCounter     := TRUE;
        END_IF;


    // ---------------- Opening ----------------
    E_FlapState.Opening:
        IF bMotorFault THEN
            eStateInt := E_FlapState.Fault;
        ELSE
            bDrvOpen  := TRUE;
            bDrvClose := FALSE;
            bIsMoving := TRUE;

            // profil prędkości
            IF nEncClamped < (nTargetOpen - nDecelImp) THEN
                rFreqSetpoint := rOpenFast;
            ELSE
                rFreqSetpoint := rOpenSlow;
            END_IF;

            // stop
            IF bAuto THEN
                // AUTO: stop na SP
                IF nEncClamped >= (nSP_Imp - nTolImpPos) THEN
                    bDrvOpen      := FALSE;
                    rFreqSetpoint := 0.0;
                    eStateInt     := E_FlapState.Opened; // HOLD/IN_POS
                END_IF;
            ELSE
                // MANUAL: stop na ~100%
                IF nEnc >= (nTargetOpen - TOLImp) THEN
                    bDrvOpen      := FALSE;
                    rFreqSetpoint := 0.0;
                    eStateInt     := E_FlapState.Opened;
                END_IF;
            END_IF;
        END_IF;


    // ---------------- Opened (HOLD/IN_POS w AUTO) ----------------
    E_FlapState.Opened:
        bDrvOpen      := FALSE;
        bDrvClose     := FALSE;
        rFreqSetpoint := 0.0;
        bIsMoving     := FALSE;


    // ---------------- Closing ----------------
    E_FlapState.Closing:
        IF bMotorFault THEN
            eStateInt := E_FlapState.Fault;
        ELSE
            bDrvOpen  := FALSE;
            bDrvClose := TRUE;
            bIsMoving := TRUE;

            // profil prędkości
            IF nEncClamped > nDecelImp THEN
                rFreqSetpoint := rCloseFast;
            ELSE
                rFreqSetpoint := rCloseSlow;
            END_IF;

            // STOP:
            // Najważniejsze: do HOME zatrzymujemy na bHomeSensor (level), a nie tylko na rZ.Q.
            IF bAuto THEN
                IF uiPosSP_Percent = 0 THEN
                    // AUTO: SP=0 => HOME
                    IF bHomeSensor THEN
                        bDrvClose     := FALSE;
                        rFreqSetpoint := 0.0;
                        eStateInt     := E_FlapState.IdleClosed;

                        // Zerowanie licznika (może być też w IdleClosed – tu jest pewniej)
                        uiSetCounterVal := 0;
                        bSetCounter     := TRUE;
                    END_IF;
                ELSE
                    // AUTO: stop na SP
                    IF nEncClamped <= (nSP_Imp + nTolImpPos) THEN
                        bDrvClose     := FALSE;
                        rFreqSetpoint := 0.0;
                        eStateInt     := E_FlapState.Opened; // HOLD/IN_POS
                    END_IF;
                END_IF;

            ELSE
                // MANUAL: zawsze do HOME
                IF bHomeSensor THEN
                    bDrvClose     := FALSE;
                    rFreqSetpoint := 0.0;
                    eStateInt     := E_FlapState.IdleClosed;

                    uiSetCounterVal := 0;
                    bSetCounter     := TRUE;
                END_IF;
            END_IF;
        END_IF;


    // ---------------- Fault ----------------
    E_FlapState.Fault:
        bDrvOpen      := FALSE;
        bDrvClose     := FALSE;
        rFreqSetpoint := 0.0;
        bIsMoving     := FALSE;
        bFlapFault    := TRUE;
        bSetCounter   := FALSE;

        IF bResetFault AND NOT bMotorFault THEN
            bFlapFault := FALSE;
            eStateInt  := E_FlapState.IdleClosed;
        END_IF;

END_CASE;


// ============================================================
// 7) bIsOpen / bIsClosed (SCADA)
// ============================================================

// ZAMKNIĘTE tylko po HOME + IdleClosed (Twoje wymaganie)
bIsClosed := bHomeSensor AND (eStateInt = E_FlapState.IdleClosed);

// OTWARTE tylko po % blisko 100% (bez eStateInt=Opened)
bIsOpen := (rPosPV_Percent >= (100.0 - rTolPerc));


// ============================================================
// 8) bInPos (AUTO)
// ============================================================
IF bAuto AND (eStateInt <> E_FlapState.Fault) THEN
    IF uiPosSP_Percent = 0 THEN
        bInPos := bHomeSensor AND (eStateInt = E_FlapState.IdleClosed);
    ELSE
        bInPos := (nEncClamped >= (nSP_Imp - nTolImpPos)) AND (nEncClamped <= (nSP_Imp + nTolImpPos));
    END_IF;
ELSE
    bInPos := FALSE;
END_IF;


// ============================================================
// 9) Diagnostyka tekstowa + stan na wyjście
// ============================================================
eState := eStateInt;

CASE eStateInt OF
    E_FlapState.IdleClosed:
        sStatusText := 'Zamknieta (HOME)';

    E_FlapState.Opening:
        IF bAuto THEN
            sStatusText := 'Otwieranie do SP (AUTO)';
        ELSE
            sStatusText := 'Otwieranie (MANUAL)';
        END_IF;

    E_FlapState.Closing:
        IF bAuto THEN
            IF uiPosSP_Percent = 0 THEN
                sStatusText := 'Zamykanie do HOME (AUTO SP=0)';
            ELSE
                sStatusText := 'Zamykanie do SP (AUTO)';
            END_IF;
        ELSE
            sStatusText := 'Zamykanie do HOME (MANUAL)';
        END_IF;

    E_FlapState.Opened:
        IF bAuto THEN
            sStatusText := 'W pozycji (AUTO)';
        ELSE
            sStatusText := 'Otwarta (MANUAL)';
        END_IF;

    E_FlapState.Fault:
        sStatusText := 'Awaria klapy';

ELSE
    sStatusText := 'Nieznany stan';
END_CASE;

]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>