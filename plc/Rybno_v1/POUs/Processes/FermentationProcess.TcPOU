<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FermentationProcess" Id="{553c9373-2315-45e5-ad38-9104f2f846ac}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM FermentationProcess
VAR
	
(************** NAPĘDY **************************************************)
	fbDrv_MX01 		 : FB_Drive_1C();		//Napedy U11 mieszadła MX01	
	fbDrvContr_MX01  : FB_DriveControl(fbDrv_MX01);

	fbDrv_MX02 		 : FB_Drive_1C(); 		//Napedy U11 mieszadła MX01	
	fbDrvContr_MX02  : FB_DriveControl(fbDrv_MX02);

(************** Temp Sensor **************************************************)
	fbTempSens_T01	 : FB_Scaling; //Czujnik temperatury w reaktorze R01
	
(************** Ph Sensor **************************************************)
	fbPhSens_Ph01	 : FB_Scaling; //Czujnik ph w reaktorze R01

(************** Pressure Sensor **************************************************)
	fbPressureSens_P01	 : FB_Scaling; //Czujnik ciśnienia w reaktorze R01

(************** Hydrostatic pressure Sensor ************************************)
	fbHydrosPressureSens_HP01	  : FB_Scaling;
	
(************** Level Sensor **************************************************)
	fbLevelSens_L01	 : FB_Scaling; //Czujnik poziomu cieczy w reaktorze R01

(************** Reactor Mixers ***********************************************)
	fbReactorMixers	 : FB_ReactorMixer;	
	
(****************** ZW01 ******************************************************)
	fbContactor_ZW01	:	FB_Contactor(en:=GVL_Fermentation.stContactor_ZW01.bCmd);
	
	//filtry medianowe czujników analagowych
	fbMedian5_temp			: FB_Median5;
	fbMedian5_Pressure		: FB_Median5;
	fbMedian5_HydroPressure	: FB_Median5;
	fbMedian5_PhSens		: FB_Median5;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//Action
ACT_PhSens();       //skalowanie ph
ACT_PressureSens(); //skalowanie ciśnienie
ACT_TempSens();     //skalowanie temperatura
ACT_LevelSens();    //skalowanie poziom
ACT_Motor();    	//nastawy z SCADA
ACT_ReactorMixers();//Mieszanie w R01



//MX01
fbDrvContr_MX01();
GVL_Fermentation.stDriveStatus_MX01 := fbDrvContr_MX01.StatusStruct(); //zwróc strukturę

//MX02
fbDrvContr_MX02();
GVL_Fermentation.stDriveStatus_MX02 := fbDrvContr_MX02.StatusStruct(); //zwróc strukturę

//ZW01
fbContactor_ZW01();
GVL_Fermentation.stContactor_ZW01.bOut	:=	fbContactor_ZW01.State; //zwróc stan]]></ST>
    </Implementation>
    <Action Name="ACT_LevelSens" Id="{5aba7613-72d4-4290-9316-0bee355161b2}">
      <Implementation>
        <ST><![CDATA[//Wyznacz poziom płynu w komorze fermentora zgodnie z wzorem (mH2O-P[kPa]*0.1)+poziom na ktorym wisi sonda hydrostatyczna
//przyjeto Ro =1kg/m3 g=9.81m2/s
GVL_Fermentation.LevelSens_R01.rValue := GVL_Fermentation.HydroPressSens_R01.rValue - GVL_Fermentation.PressureSens_R01.rValue * 0.1 + 0.12;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="ACT_Motor" Id="{8b1ba2b0-5de3-4317-90d1-d6c08d7f8f90}">
      <Implementation>
        <ST><![CDATA[//Naped ustawienia MX01 i MX02
//nastawy z SCADA MX01
fbDrvContr_MX01.SetForward:=GVL_Fermentation.stDriveStatus_MX01.bForward;
//nastawy z SCADA MX02
fbDrvContr_MX02.SetForward:=GVL_Fermentation.stDriveStatus_MX02.bForward;


]]></ST>
      </Implementation>
    </Action>
