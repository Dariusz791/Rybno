<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <DUT Name="ST_DachsOpcUa" Id="{3756ceb3-d18e-405d-a32c-04b8d372be6b}">
    <Declaration><![CDATA[TYPE ST_DachsOpcUa :
STRUCT
    // --- Komendy / tryb ze SCADA ---
	bStartCmd 			  : BOOL;          // przycisk START ze SCADA, monostabilny
	bStopCmd              : BOOL;  		   // przycisk STOP ze SCADA, monostabilny
	bReset                : BOOL;          // reset zatrzasku alarmu
	
	//Status
	bControlEnabled       : BOOL; 			// blok sterowania aktywny

    eMode                 : E_DachsMode;   // Off / Auto / Manual
    bManualRunPermission  : BOOL;          // ręczna zgoda pracy
    

    // --- Nastawy ze SCADA ---
    rPressureStart_kPa    : REAL;          // próg załączenia, np. 5.5
    rPressureStop_kPa     : REAL;          // próg wyłączenia, np. 3.5

    // --- Status / diagnostyka do SCADA ---
    eState                : E_DachsState;  // stan pracy
    bRunPermission        : BOOL;          // logiczna zgoda pracy Dachsa
    bStopContact          : BOOL;          // TRUE = styk zwarty = STOP

    bIsRunning            : BOOL;          // zgoda pracy aktywna
    bIsStopped            : BOOL;          // zgoda pracy zdjęta
	
    bAutoActive           : BOOL;
    bManualActive         : BOOL;
	
	bFlowOk				  : BOOL;	
    bAlarm                : BOOL;          // alarm zatrzaśnięty w PLC

    bPressureStartReached : BOOL;          // ciśnienie >= próg startu
    bPressureStopReached  : BOOL;          // ciśnienie <= próg stopu
	
    // --- Diagnostyka ---
    sDiag                 : T_MaxString;	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>