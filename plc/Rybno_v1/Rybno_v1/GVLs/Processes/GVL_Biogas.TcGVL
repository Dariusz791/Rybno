  <GVL Name="GVL_Biogas" Id="{8dfb3913-2151-4699-afbe-a42ce21137df}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
	
	
(**************************************************** GH-01 *****************************************************************)		
	//**************************** Pressure Sensor 01 ***************************************************************
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.AnalogItemType' := '1'}
	{attribute 'OPC.UA.DA.AnalogItemType.EngineeringUnits' := '4935745'  }(*EngeneeringUnit = kPa*)
	{attribute 'OPC.UA.DA.AnalogItemType.InstrumentRange' := '0:10'  } (*0- 10kPa*)
	{attribute 'OPC.UA.DA.AnalogItemType.EURange' := '3:6'  }			(*pracujemy w zakresie od 3 do 6 kPa*)
	{attribute 'OPC.UA.DA.AnalogItemType.WriteBehavior' := '2'  } (*AnalogWrMode_AllowAny = 0,
																	AnalogWrMode_Clamp = 1,
																	AnalogWrMode_Reject = 2,*)
	PressureSens_GH01 : ST_AnalogSens;
	



(**************************************************** DS-01 *****************************************************************)		
	//**************************** Pressure Sensor 01 ***************************************************************
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.AnalogItemType' := '1'}
	{attribute 'OPC.UA.DA.AnalogItemType.EngineeringUnits' := '4935745'  }(*EngeneeringUnit = kPa*)
	{attribute 'OPC.UA.DA.AnalogItemType.InstrumentRange' := '0:10'  } (*0- 10kPa*)
	{attribute 'OPC.UA.DA.AnalogItemType.EURange' := '3:6'  }			(*pracujemy w zakresie od 3 do 6 kPa*)
	{attribute 'OPC.UA.DA.AnalogItemType.WriteBehavior' := '2'  } (*AnalogWrMode_AllowAny = 0,
																	AnalogWrMode_Clamp = 1,
																	AnalogWrMode_Reject = 2,*)
	PressureSens_DS01 : ST_AnalogSens;
	
	
(**************************************************** Flowemeter F-01 *****************************************************************)	
	//**************************** Flow Sensor F-01 ***************************************************************
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	{attribute 'OPC.UA.DA.Description' := 'FlowSens_F01 (structured) type '}
	
	FlowSens_F01 : ST_DigitalSens;
	
	//**************************** Flow Counter F-01 ***************************************************************
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	{attribute 'OPC.UA.DA.Description' := 'stFlowCounter_F01 (structured) type '}	
	stFlowCounter_F01 : ST_FlowCounter; 
		
(**************************************************** GA-01 *****************************************************************)		
	//**************************** Gas Analyzator GA 01 ***************************************************************
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	{attribute 'OPC.UA.DA.Description' := 'stGasAnalyzer_GA01 (structured) type '}
																	
	stSWG100_Biogas : ST_SWG100_Biogas;	
	
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	{attribute 'OPC.UA.DA.Description' := 'stSWG100_Status (structured) type '	}
	
	stSWG100_Status	 : ST_SWG100_Status;
	
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	{attribute 'OPC.UA.DA.Description' := 'stSWG100_Status (structured) type '	}
	
	stSWG100_Alarms	 : ST_SWG100_Alarms;	

(**************************************************** Tch-01 *****************************************************************)		
	//**************************** Torch 01 ***************************************************************
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.StructuredType' := '1'}
	{attribute 'OPC.UA.DA.Description' := 'stTorchAds_Tch01 (structured) type '} 
	stTorchAds_Tch01 : ST_TorchAdsStruct;
	
	//**************************** Torch reset SCADA BUTTON - ze stacyjki pcohodni ***************************************************************
	{attribute 'OPC.UA.DA' := '1'}
	bResetScadaButton	: BOOL;
	
	
END_VAR]]></Declaration>
