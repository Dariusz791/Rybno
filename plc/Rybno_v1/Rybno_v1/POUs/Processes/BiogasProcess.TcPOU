<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="BiogasProcess" Id="{42ee1a91-553f-4003-838c-56a71dec62fc}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM BiogasProcess
VAR
	
(************** Pressure Sensor **************************************************)
	fbPressureSens_GH01	 : FB_Scaling; //Czujnik ciśnienia w  GH01
	

(************** Flow Sensor **************************************************)
	fbFlowSens_F01		 : FB_DigitalSensNO; //Czujnik poziomu cieczy w reaktorze R01

(************** Flow Counter **************************************************)	
   fbFlowCounter_F01	 : FB_FlowCounter;	


	fbMedian_PressureSens: FB_Median5;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[ACT_PressureSens();
ACT_FlowSens();
ADS_BiogasTorch();
]]></ST>
    </Implementation>
