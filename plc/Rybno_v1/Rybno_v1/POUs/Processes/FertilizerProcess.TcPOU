<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FertilizerProcess" Id="{ae9cea5e-de76-4d67-bab9-1dcc1d16bc80}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM FertilizerProcess
VAR

(***********************************************Napedy w procesie produkcji nawozu z pofermentu i osadu****************************************************************************************)
	//Napedy U11 pompy SP02	
	fbDrvInv_SP02 		: FB_DriveInv(1, E_InvType.Schneider);
	fbDrvContrInv_SP02  : FB_DriveControl(fbDrvInv_SP02);

	//Napedy M01 M02 VR01 - schemat U71, U81	
	fbDrvInv_M01 		: FB_DriveInv(7, E_InvType.Schneider);
	fbDrvContrInv_M01   : FB_DriveControl(fbDrvInv_M01);
	
	fbDrvInv_M02 		: FB_DriveInv(8, E_InvType.Schneider);
	fbDrvContrInv_M02   : FB_DriveControl(fbDrvInv_M02);
	
	//Naped klapy M03 VR01 - schemat U91 
	fbDrvInv_M03 		: FB_DriveInv(9, E_InvType.Schneider);
	fbDrvContrInv_M03   : FB_DriveControl(fbDrvInv_M03);
	
	//Naped wentylator BL01
	fbDrv_BL01			: FB_Drive_1C();
	fbDrvContr_BL01		: FB_DriveControl(fbDrv_BL01);

	//Napedy podajnik SC-01 i SC02
	fbDrv_SC01			: FB_Drive_1C();
	fbDrvContr_SC01	    : FB_DriveControl(fbDrv_SC01);
	
	fbDrv_SC02			: FB_Drive_1C();
	fbDrvContr_SC02		: FB_DriveControl(fbDrv_SC02);
		
	//Napedy S01_E01 i S02_E02
	fbDrv_E01			: FB_Drive_1C();
	fbDrvContr_E01	    : FB_DriveControl(fbDrv_E01);
	
	fbDrv_E02			: FB_Drive_1C();
	fbDrvContr_E02		: FB_DriveControl(fbDrv_E02);
	


(***********************************************Czujniki w procesie produkcji nawozu z pofermentu i osadu****************************************************************************************)
	//Temp Sensor
	fbTempSens_H01	 	: FB_Scaling; //Czujnik temperatury w hali H01
	
	//Rotary Sensor
	fbRotarySens_S01	 : FB_DigitalSensNC; //Czujnik poziomu w silosien S01 typu NC
	fbRotarySens_S02	 : FB_DigitalSensNC; //Czujnik poziomu w silosien S02 typu NC



(*********************************************** Bloki Process Controlller****************************************************************************************)

	(************** Granulation controller **************************************************)
	fbGranulationProcess : FB_GranulationProcess;
	
	(************** Flap controller **************************************************)
	fbFlapControl		: FB_FlapCtrl; //controller bloku sterowania klapa
	
	(************* Sludge dosing Controller ******************************************)
	fbSludgeDosing		: FB_SludgeDosing;
	
	(************ Manual Valve Position **********************************************)
	fbValvePosition_ZR01 : FB_DigitalSensNO;
	fbValvePosition_ZR02 : FB_DigitalSensNO;


	(****************** ZW02 - Przekaźnik K301 ******************************************************)
	fbContactor_ZW02	:	FB_Contactor(en:=GVL_Fertilizer.stContactor_ZW02.bCmd);
	
	(****************** H01 - Przekaźnik K303 ******************************************************)
	fbContactor_H01	:	FB_Contactor(en:=GVL_Cogeneration.stMixit_H01.Out); //uruchom wentylator gdy dziala mixit

	
	
	fbMedian5_TempSens: FB_Median5;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//Action
//Czujniki
ACT_WeightSensor(); //Sensor wagowy
ACT_TempSens();		//Sensor temperatury
ACT_DigitalSens();  //Sensory poziomu

//Automat dozowania granulowania  i dozowania fermentacji
ACT_Control(); //Sterowanie procesem granulacji
ACT_SludgeDosing(); //sterowanie dozowaniem osadu do reaktora fermentacji R01


//Wybór nastawy napedów Auto lub SCADA
ACT_Motor(); //nastawy z SCADA



//**********************************SP-02*********************************************
//SP02
fbDrvContrInv_SP02();
GVL_Fertilizer.stDriveStatus_SP02 := fbDrvContrInv_SP02.StatusStruct(); //zwróc strukturę

//mode SP02
// 0 - ręka
// 1 - fermentacja
// 2 - granulacja
// 3 - konflikt zaworów

IF GVL_Fertilizer.ValvePosition_ZR01.bValue AND NOT GVL_Fertilizer.ValvePosition_ZR02.bValue THEN
    GVL_Fertilizer.iSP02_Mode := 1;

ELSIF GVL_Fertilizer.ValvePosition_ZR02.bValue AND NOT GVL_Fertilizer.ValvePosition_ZR01.bValue THEN
    GVL_Fertilizer.iSP02_Mode := 2;

ELSIF NOT GVL_Fertilizer.ValvePosition_ZR01.bValue AND NOT GVL_Fertilizer.ValvePosition_ZR02.bValue THEN
    GVL_Fertilizer.iSP02_Mode := 0;

ELSE
    GVL_Fertilizer.iSP02_Mode := 3;
END_IF;



//**********************************VR01*****************************************************
//M01
fbDrvContrInv_M01();
GVL_Fertilizer.stDriveStatus_M01 := fbDrvContrInv_M01.StatusStruct(); //zwróc strukturę
//M02
fbDrvContrInv_M02();
GVL_Fertilizer.stDriveStatus_M02 := fbDrvContrInv_M02.StatusStruct(); //zwróc strukturę
//M03
fbDrvContrInv_M03();
GVL_Fertilizer.stDriveStatus_M03 := fbDrvContrInv_M03.StatusStruct();

//**********************************Silosy S01 i S02*****************************************************
//SC01
fbDrvContr_SC01();
GVL_Fertilizer.stDriveStatus_SC01 := fbDrvContr_SC01.StatusStruct(); //zwróc strukturę
//SC02
fbDrvContr_SC02();
GVL_Fertilizer.stDriveStatus_SC02 := fbDrvContr_SC02.StatusStruct(); //zwróc strukturę
//E01
fbDrvContr_E01();
GVL_Fertilizer.stDriveStatus_E01 := fbDrvContr_E01.StatusStruct(); //zwróc strukturę
//E02
fbDrvContr_E02();
GVL_Fertilizer.stDriveStatus_E02 := fbDrvContr_E02.StatusStruct(); //zwróc strukturę

//**********************************BL01*****************************************************
//BL01
fbDrvContr_BL01();
GVL_Fertilizer.stDriveStatus_BL01 := fbDrvContr_BL01.StatusStruct(); //zwróc strukturę


//ZW02
fbContactor_ZW02();
GVL_Fertilizer.stContactor_ZW02.bOut	:=	fbContactor_ZW02.State; //zwróc stan

//H01 nagrzewnica wentylat
fbContactor_H01();
GVL_Fertilizer.stContactor_H01.bOut	:=	fbContactor_H01.State; //zwróc stan

]]></ST>
    </Implementation>
