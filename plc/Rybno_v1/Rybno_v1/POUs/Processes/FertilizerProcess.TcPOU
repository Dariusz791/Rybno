    <Action Name="ACT_Motor" Id="{157fa111-0c10-4c74-bf66-984a77c8c761}">
      <Implementation>
        <ST><![CDATA[
//************Naped ustawienia SP02**********************
//nastawy z SCADA lub z PLC blok nadrzędny wybór SELektorem
CASE GVL_Fertilizer.iSP02_Mode OF

    1: // FERMENTACJA
        fbDrvContrInv_SP02.SetForward   := fbSludgeDosing.bCmd_Pump;
        fbDrvContrInv_SP02.SetReverse   := FALSE;
        fbDrvContrInv_SP02.FreqSetPoint := fbSludgeDosing.rSpeedSet;

    2: // GRANULACJA
        fbDrvContrInv_SP02.SetForward   := fbGranulationProcess.bSP02_Fwd;
        fbDrvContrInv_SP02.SetReverse   := FALSE;
        fbDrvContrInv_SP02.FreqSetPoint := fbGranulationProcess.rSP02_Hz;

    0: // RĘKA
        fbDrvContrInv_SP02.SetForward   := GVL_Fertilizer.stDriveStatus_SP02.bForward;
        fbDrvContrInv_SP02.SetReverse   := GVL_Fertilizer.stDriveStatus_SP02.bReverse;
        fbDrvContrInv_SP02.FreqSetPoint := GVL_Fertilizer.stDriveStatus_SP02.FrequencySet;

    ELSE // KONFLIKT
        fbDrvContrInv_SP02.SetForward   := FALSE;
        fbDrvContrInv_SP02.SetReverse   := FALSE;
        fbDrvContrInv_SP02.FreqSetPoint := 0.0;
END_CASE;


//fbDrvContrInv_SP02.SetForward	:=SEL(fbGranulationProcess.bAutoTakeOver, GVL_Fertilizer.stDriveStatus_SP02.bForward, fbGranulationProcess.bSP02_Fwd);
//fbDrvContrInv_SP02.SetReverse	:=SEL(fbGranulationProcess.bAutoTakeOver, GVL_Fertilizer.stDriveStatus_SP02.bReverse, FALSE); // w automacie nie ma reverse
//fbDrvContrInv_SP02.FreqSetPoint	:=SEL(fbGranulationProcess.bAutoTakeOver, GVL_Fertilizer.stDriveStatus_SP02.FrequencySet, fbGranulationProcess.rSP02_Hz);

//***********Naped ustawienia VR01************************
//nastawy z SCADA M01 lub z PLC blok nadrzędny wybór SELektorem
fbDrvContrInv_M01.SetForward	:=SEL(fbGranulationProcess.bAutoTakeOver, GVL_Fertilizer.stDriveStatus_M01.bForward, fbGranulationProcess.bM01_Fwd);
fbDrvContrInv_M01.SetReverse	:=SEL(fbGranulationProcess.bAutoTakeOver, GVL_Fertilizer.stDriveStatus_M01.bReverse, FALSE);
fbDrvContrInv_M01.FreqSetPoint	:=SEL(fbGranulationProcess.bAutoTakeOver, GVL_Fertilizer.stDriveStatus_M01.FrequencySet, fbGranulationProcess.rMix_Hz);

//nastawy z SCADA M02 lub z PLC blok nadrzędny wybór SELektorem
fbDrvContrInv_M02.SetForward	:=SEL(fbGranulationProcess.bAutoTakeOver, GVL_Fertilizer.stDriveStatus_M02.bForward, fbGranulationProcess.bM02_Fwd);
fbDrvContrInv_M02.SetReverse	:=SEL(fbGranulationProcess.bAutoTakeOver, GVL_Fertilizer.stDriveStatus_M02.bReverse, FALSE);
fbDrvContrInv_M02.FreqSetPoint	:=SEL(fbGranulationProcess.bAutoTakeOver, GVL_Fertilizer.stDriveStatus_M02.FrequencySet, fbGranulationProcess.rMix_Hz);

//nastawy z SCADA M03
//fbDrvContrInv_M03.SetForward	:=GVL_Fertilizer.stDriveStatus_M03.bForward;
//fbDrvContrInv_M03.SetReverse	:=GVL_Fertilizer.stDriveStatus_M03.bReverse;
//fbDrvContrInv_M03.FreqSetPoint  :=GVL_Fertilizer.stDriveStatus_M03.FrequencySet;

//***********Naped ustawienia S01 i S02************************
//nastawy z SCADA SC01
fbDrvContr_SC01.SetForward	:=SEL(fbGranulationProcess.bAutoTakeOver, GVL_Fertilizer.stDriveStatus_SC01.bForward, fbGranulationProcess.bSC01_On);
//nastawy z SCADA SC02
fbDrvContr_SC02.SetForward	:=SEL(fbGranulationProcess.bAutoTakeOver, GVL_Fertilizer.stDriveStatus_SC02.bForward, fbGranulationProcess.bSC02_On);
//nastawy z SCADA E01
fbDrvContr_E01.SetForward	:=SEL(fbGranulationProcess.bAutoTakeOver, GVL_Fertilizer.stDriveStatus_E01.bForward, fbGranulationProcess.bE01_On);
//nastawy z SCADA E02
fbDrvContr_E02.SetForward	:=SEL(fbGranulationProcess.bAutoTakeOver, GVL_Fertilizer.stDriveStatus_E02.bForward, fbGranulationProcess.bE02_On);

////***********Naped ustawienia BL01 ************************
//nastawy z SCADA BL01
fbDrvContr_BL01.SetForward	:=SEL(fbGranulationProcess.bAutoTakeOver, GVL_Fertilizer.stDriveStatus_BL01.bForward, fbGranulationProcess.bBL01_On);


]]></ST>
      </Implementation>
    </Action>
