    <Property Name="IsRunning" Id="{d62d39a7-703c-4002-aa4a-0ed906638fe8}" FolderPath="Properties\Status\">
      <Declaration><![CDATA[PROPERTY IsRunning : BOOL
]]></Declaration>
      <Get Name="Get" Id="{ea63fa90-ea31-4184-bbe4-465e0e3fa95c}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsRunning := EtaHasBit(_stInverter.wInvStatusWord, E_EtaBit.OperEnabled) AND NOT EtaHasBit(_stInverter.wInvStatusWord, E_EtaBit.DirRev);]]></ST>
        </Implementation>
      </Get>
    </Property>
