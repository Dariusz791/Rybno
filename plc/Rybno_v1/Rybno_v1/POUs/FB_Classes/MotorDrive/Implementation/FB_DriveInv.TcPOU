    <Property Name="AtSpeed" Id="{7ebf9d48-ac3a-46b6-bd4f-79f980ebea2b}" FolderPath="Properties\Speed\">
      <Declaration><![CDATA[PROPERTY AtSpeed : BOOL]]></Declaration>
      <Get Name="Get" Id="{26deacff-d269-4f49-89d4-88876f43fb3e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[AtSpeed := EtaHasBit(_stInverter.wInvStatusWord, E_EtaBit.AtSpeed);
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CommOk" Id="{09728eaa-9276-4104-b401-530e764e10d2}" FolderPath="Properties\Status\">
      <Declaration><![CDATA[PROPERTY CommOk : BOOL]]></Declaration>
      <Get Name="Get" Id="{ddad8bc1-dd14-45f3-8603-2ba4970767b0}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CommOk := _stInverter.bCommOk;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{6b7d97cd-b407-459b-a06c-07a364894300}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_stInverter.bCommOk := CommOk;
]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="Cycle" Id="{5ff6d694-42e7-4915-a107-7ec0910a6f23}">
      <Declaration><![CDATA[METHOD Cycle : BOOL

]]></Declaration>
      <Implementation>
        <ST><![CDATA[// ciało FB (co cykl)

//błąd napedu
_fault := NOT _termFuseOk.IsActive; //zadziałał termik lub falownik ma bład z słowa statusu 

_cmdFwd := _reqFwd AND NOT _reqRev AND _safetyOk AND _permOk AND NOT _fault;
_cmdRev := _reqRev AND NOT _reqFwd AND _safetyOk AND _permOk AND NOT _fault;

//instancje styczników (przekażników) załączajaccyh przód tył
Fwd();  Rev();

//----w przypadku falownika potwierdzamy ze slowa statusu falownika maskuajc odpowiedni bit pobierammmy getterem
_isRunning    := IsRunning;
_isRunningRev := IsRunningRev;

//Odliczanie czasu pracy
_fbWorkTimeCounter.Execute(_wtEnable AND (_isRunning OR _isRunningRev));
_stWorkTime := _fbWorkTimeCounter.WorkTime;


//ustawienia _stInverter tylko przekazujemy Hz, SlaveId, InvType przekazane w FB_INIT 
_stInverter.rFreqSetPoint := _rSetHz;
_rActHz := _stInverter.rFreqActual; //ustaw odczytana actualna czestotliwosc z Modbus

Cycle:=TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Fault" Id="{52a188d9-3e41-429e-817b-3f62a2e7e738}" FolderPath="Properties\Status\">
      <Declaration><![CDATA[PROPERTY Fault : BOOL
]]></Declaration>
      <Get Name="Get" Id="{db474149-d812-4fda-97a3-a696d66daf32}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Fault := EtaHasBit(_stInverter.wInvStatusWord, E_EtaBit.Fault);
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_init" Id="{ec766e15-c923-48ff-bc8b-53f7a80f7482}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // if TRUE, the retain variables are initialized (warm start / cold start)
	bInCopyCode  : BOOL;  // if TRUE, the instance afterwards gets moved into the copy code (online change)
	bDeviceId    : BYTE;           //Adres Slave falownika
	eDeviceType	 : E_InvType; //Enum z typem falownika	
END_VAR

VAR
	fbDriveRegistry : FB_DriveRegistry;

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//UStaw adres slava oraz model falownika
THIS^._stInverter.nSlaveId := bDeviceId;
THIS^._stInverter.eInvModel := eDeviceType;


//Rejestracja struktury
fbDriveRegistry.Register( ADR(_stInverter), index => _idx);   // <<< statyczna metoda klasy]]></ST>
      </Implementation>
    </Method>
