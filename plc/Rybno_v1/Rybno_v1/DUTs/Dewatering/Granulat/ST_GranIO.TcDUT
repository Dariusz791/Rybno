  <DUT Name="ST_GranIO" Id="{e8293dd5-deb9-44f3-96f4-a337f9f5e5d9}">
    <Declaration><![CDATA[TYPE ST_GranIO :
STRUCT
    // SCADA → FB
    bAuto          : BOOL;
    bStartCycle    : BOOL;
    bStop          : BOOL;
    bResetFault    : BOOL;
    SP             : ST_GranSP;

    // FB → SCADA
    bReady         : BOOL;
    bRunning       : BOOL;
    bFault         : BOOL;
    eStep          : E_GranStep;
    eFault         : E_GranFault;

    rTareKg        : REAL;
    rBatchKg       : REAL;   // rMassRaw - rTare
    rDosSludgeKg   : REAL;
    rDosPerliteKg  : REAL;
    rDosLimeKg     : REAL;

    // diagnostyka
    sDiag          : STRING(120);
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
