<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="E_SludgeDoseStep" Id="{fd8bc4a8-c212-4b1a-8c63-7bf4e8d44ad6}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_SludgeDoseStep :
(
    IDLE          := 0,
    PRIME 		  :=10,          // wstępne "przepchnięcie" / próba napełnienia końcówki (opcjonalnie)
    TEST_ON		  :=20,        // impuls testowy (np. 30s @ 25Hz)
    TEST_OFF_EVAL :=30,  // pauza + ocena Δm
    WAIT_EMPTY    :=40,     // długie czekanie gdy brak przyrostu
    COLLECT_ON    :=50,     // impuls roboczy (np. 30s @ 30Hz)
    WAIT_COLLECT  :=60    // krótkie czekanie gdy było poleciało
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>