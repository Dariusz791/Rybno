  <DUT Name="ST_GranHmiSP" Id="{cfe112a4-054e-4cff-88f6-039a354f8982}">
    <Declaration><![CDATA[TYPE ST_GranHmiSP :
STRUCT
    rSludgeKg     : REAL;   // [kg] masa osadu na jeden cykl
    rPerliteKg    : REAL;   // [kg] masa perlitu na jeden cykl
    rLimeKg       : REAL;   // [kg] masa wapna na jeden cykl
    uiMixMin      : UINT;   // [min] czas mieszania
    uiFlapOpenPct : UINT;   // [%] 0..100 pozycja klapy do wysypu
    rResiduumKg   : REAL;   // [kg] docelowe residuum po wysypie
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
