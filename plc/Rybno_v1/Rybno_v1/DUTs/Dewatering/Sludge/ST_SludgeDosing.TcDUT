<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <DUT Name="ST_SludgeDosing" Id="{b6a8881a-00c5-4fba-bfac-231df5211547}">
    <Declaration><![CDATA[TYPE ST_SludgeDosing :
STRUCT
    // ===========================================
    // KOMENDY z SCADA → PLC
    // ===========================================

    bEnable        : BOOL;   // true = włącz cykl dozowania (AUTO)
    iTon           : DINT;   // nastawa: czas pracy pompy dozującej [min]
    iToff          : DINT;   // nastawa: czas przerwy pompy dozującej  [min]


    // ===========================================
    // STATUS z PLC → SCADA
    // ===========================================
	bFault		   : BOOL;	 // awaria pompy dozującej
    iStep          : INT;    // aktualny krok sekwencji (10=postój pompy oczekiwanie na napełnienie kosza, 20=dozowanie, 40=awaria napędu)

    // czasy trwania aktualnej fazy [s]
    tOnSP02Elapsed     : TIME;   // ile czasu dozuje SP02 w bieżącym cyklu
    tOffSP02Elapsed    : TIME;   // ile czasu trwa postój (TOFF) na napełnienie kosza
	  	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>