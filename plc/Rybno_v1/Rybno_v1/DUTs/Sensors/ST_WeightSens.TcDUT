  <DUT Name="ST_WeightSens" Id="{76ca8fd7-42e4-4145-a4c0-93be61d5cc6b}">
    <Declaration><![CDATA[{attribute 'OPC.UA.DA' := '2'}
{attribute 'OPC.UA.DA.StructuredType' := '1'}
TYPE ST_WeightSens :
STRUCT
	
	bZeroingScale		: BOOL;  		// command to zeroing scale from SCADA button
	iFilter				: INT;	 		// set integer value from 0 to 5 
	sStatus				: T_MaxString; 	// measure status
	rRawWeightValue 	: WORD;	 		// raw value from measure instruments
	rWeightValue  		: REAL; 		 // value from fermentation tank temperature sensor	

END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
