  <DUT Name="ST_Inverter" Id="{2cbd0276-4f64-4bf7-9ff5-8c819910d554}">
    <Declaration><![CDATA[TYPE ST_Inverter :
STRUCT
	nSlaveId		 	: BYTE;	//Slave ID
	rFreqSetPoint	 	: REAL;	//wartość zadana predkosci dla INV
	rFreqActual      	: REAL;	//wartość częstotliwości odczytana z INV
	rCurrActual			: REAL; //wartość prądu odczytana z INV
	rTorqActual			: REAL;	//wartość momentu procentowa z INV
	rPowerActual		: REAL; //wartość mocy procentowa odczytana z INV			
	rLastWrittenSetPt	: REAL;	//ostatnio zapisany SetPoint
	bCommOk		     	: BOOL;	//stan komunikacji po Modbus
	wInvStatusWord	 	: WORD;	//słowo statusowe INV
	eInvModel		 	: E_InvType; //Model falownika
	nNoResp			 	: UDINT;	//licznik braku odpowiedzi 	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
