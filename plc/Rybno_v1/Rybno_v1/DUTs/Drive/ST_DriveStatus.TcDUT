<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <DUT Name="ST_DriveStatus" Id="{a0617a5f-1542-45ac-ad3b-4e580265c56e}">
    <Declaration><![CDATA[TYPE ST_DriveStatus :
STRUCT
	
	//Adres slave
	SlaveId			: BYTE;		  // adres slave				
	
    // Diody
    StateLed        : INT;         // 0=Brak gotowości, 1=Gotowy, 2=Praca, 3=Awaria
    SupplyLed       : BOOL;		   // false=Off, true=On
	FwdLed			: BOOL;		   // false = naped wylaczony do przodu, true = naped uruchomiony do przodu
	RevLed			: BOOL;		   // false = naped wylaczony do tylu,	true = naped załączony do przodu 					
    AutoLed         : BOOL;		   // false=Off, true=On	

    // Status tekstowy
    StatusText      : T_MaxString;  // np. "AWARIA TERMIKA", "PRACA", "AUTO"

    // Tryb pracy
    ModeManual      : BOOL;
    ModeAuto        : BOOL;

    // Kierunek (dla Reverse i Inverter)
    bForward        : BOOL; 		//do przodu start/stop
    bReverse        : BOOL;			//do tyłu start/stop
	IsRunning		: BOOL;         //informacja pomocnicza 
	IsRunningRev	: BOOL;		    //informacja pomocnicza 			  			
	
    // MODBUS/FALOWNIK
    FrequencySet    : REAL;        // zadana częstotliwość
    FrequencyActual : REAL;        // odczytana częstotliwość
	CommOK			: BOOL;		   // łączność Modbus OK/FAIL		
	InvStatusWord	: WORD;		   // Status falownika bedą znormalizowane bity i przygotowane funkcje dla róznych falowników ustawiajace slowo statusu
	Fault			: BOOL;		   // Błąd falownika lub bład napedu np termik - trzeba wylaczyc przycisk napedu zboczem
	AtSpeed			: BOOL;		   // Silnik osiągnął prędkość zadaną	
	

    // Czas pracy
    WorkTime	    : ST_WorkTime;       // sekundy / minuty / godziny
	
	
END_STRUCT
END_TYPE

]]></Declaration>
  </DUT>
</TcPlcObject>